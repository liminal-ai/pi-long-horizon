# Dependencies
node_modules/

# Build outputs
dist/
build/
coverage/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example

# Local PI runtime state and credentials
.pi/agent/
**/.pi/agent/
.context-steward/

# Reference repositories: keep docs/files in repo-ref if needed, but ignore cloned subdirs.
repo-ref/*/

# Logs and editor/system noise
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
.idea/
.vscode/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
