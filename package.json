{
  "name": "pi-long-horizon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent": "PI_CODING_AGENT_DIR=.pi/agent pi --no-extensions --extension ./.pi/extensions/context-steward.ts --extension ./src/pi-extensions/codex-fast.ts --extension ./src/pi-extensions/codex-web-search.ts --codex-web-search --provider openai-codex --models openai-codex/gpt-5.4:high,openai-codex/gpt-5.4-mini:xhigh,openai-codex/gpt-5.5:medium,openai-codex/gpt-5.5:low,openai-codex/gpt-5.5:high",
    "agent:print": "PI_CODING_AGENT_DIR=.pi/agent pi --no-extensions --extension ./.pi/extensions/context-steward.ts --extension ./src/pi-extensions/codex-fast.ts --extension ./src/pi-extensions/codex-web-search.ts --codex-web-search -p --provider openai-codex --models openai-codex/gpt-5.4:high,openai-codex/gpt-5.4-mini:xhigh,openai-codex/gpt-5.5:medium,openai-codex/gpt-5.5:low,openai-codex/gpt-5.5:high",
    "login": "PI_CODING_AGENT_DIR=.pi/agent tsx src/login-chatgpt.ts",
    "login:openai": "node scripts/login-openai-api-key.mjs",
    "poc:login:openrouter": "node scripts/login-openrouter-api-key.mjs",
    "models": "tsx src/list-models.ts",
    "smoke:openai-token-count": "tsx scripts/smoke-openai-input-token-count.ts",
    "poc:smoke:openrouter-user-prompt": "tsx scripts/smoke-openrouter-user-prompt-smoothing.ts",
    "poc:smoke:openrouter-ping": "tsx scripts/openrouter-ping.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-node-tests.mjs service",
    "red-verify": "npm run typecheck",
    "verify": "npm run typecheck && npm run test",
    "green-verify": "npm run verify && npm run guard:no-test-changes",
    "verify-all": "npm run verify && npm run test:e2e",
    "test:e2e": "node scripts/run-node-tests.mjs e2e",
    "guard:no-test-changes": "node scripts/guard-no-test-changes.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.75.3",
    "@earendil-works/pi-ai": "0.75.3",
    "@earendil-works/pi-coding-agent": "0.75.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
